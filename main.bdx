fun int_to_string(n: int32): string {
    let str = "";
    while(n > 0) {
        let digit = n % 10;
        if(n == 0) {
            str = str + "0";
        }
        if(n == 1) {
            str = str + "1";
        }
        if(n == 2) {
            str = str + "2";
        }
        if(n == 3) {
            str = str + "3";
        }
        if(n == 4) {
            str = str + "4";
        }
        if(n == 5) {
            str = str + "5";
        }
        if(n == 6) {
            str = str + "6";
        }
        if(n == 7) {
            str = str + "7";
        }
        if(n == 8) {
            str = str + "8";
        }
        if(n == 9) {
            str = str + "9";
        }
    }

    return str;
}

fun fibonacci(n: int32): int32 {
    if n <= 1 {
        return n;
    }

    return fibonacci(n - 1) + fibonacci(n - 2);
}

fun main() {
    for let i = 0; i < 10; i = i + 1{
        print("fibonacci: " + int_to_string(fibonacci(i)));
    }
}

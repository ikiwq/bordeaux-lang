fun is_prime(n: int) -> bool {
    if n <= 1 {
        return false;
    }
    if n == 2 || n == 3 {
        return true;
    }
    if n % 2 == 0 || n % 3 == 0 {
        return false;
    }

    for let i = 5; i * i <= n; i = i + 6 {
        if n % i == 0 || n % (n + 2) == 0 {
            return false;
        }
    }

    return true;
}

fun main() {
    for let i = 0; i <= 50; i = i + 1 {
        if is_prime(i) {
            println(itoa(i) + " is prime");
        } else {
            println(itoa(i) + " is not prime");
        }
    }
}
